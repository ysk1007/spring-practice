<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<!-- Bootstrap CSS -->
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
	rel="stylesheet"
	integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
	crossorigin="anonymous">
<title>게시글 상세 페이지</title>
</head>
<body>
{{>layouts/header}}

	<div class="container mt-5">
		<div class="row">
			<div class="col-sm-20">
				<div class="container-fluid p-2 bg-primary text-white text-center">
					<h4>상세 페이지</h4>
				</div>

				<!-- 게시글 내용 출력 -->
				<table class="table">
					<tr>
						<th>#</th>
						<td>{{board.getBoardNo}}</td>
					</tr>
					<tr>
						<th>제목</th>
						<td>{{board.getBoardTitle}}</td>
					</tr>
					<tr>
						<th>내용</th>
						<td>{{board.getBoardContent}}</td>
					</tr>
				</table>
				
				<hr>

				<div>
					<a href="/board/modifyBoard?boardNo={{board.getBoardNo}}"
						class="btn btn-primary">수정</a> <a
						href="/board/deleteBoard?boardNo={{board.getBoardNo}}"
						class="btn btn-outline-danger">삭제</a> <a href="/board/boardList"
						class="btn btn-outline-primary">리스트</a>
				</div>
			</div>
		</div>
	</div>
	
{{>layouts/footer}}
</body>
</html>