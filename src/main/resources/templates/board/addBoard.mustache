<!DOCTYPE html>
<html>
<head>
<!-- Bootstrap CSS -->
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
	rel="stylesheet"
	integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
	crossorigin="anonymous">
<meta charset="UTF-8">
<title>게시글 추가</title>
</head>
<body>

	{{>layouts/header}}

	<div class="container mt-5">
		<div class="row">
			<div class="col-sm-20">
				<div class="container-fluid p-2 bg-primary text-white text-center">
					<h4>글쓰기✏️</h4>
				</div>

				<form action="/board/createBoard" method="post">

					<div class="row">
						<div class="col">
							제목:<br> <input type="text" class="form-control"
								name="boardTitle" placeholder="제목"> <br> <label
								for="content">내용:</label>
							<textarea class="form-control" rows="5" id="content"
								name="boardContent" placeholder="내용 입력.."></textarea>
						</div>

					</div>

					<hr>
	
					<div>
						<button type="submit" class="btn btn-success">추가</button>
						<a href="/board/boardList" class="btn btn-outline-primary">리스트</a>
					</div>


				</form>
			</div>
		</div>
	</div>

	{{>layouts/footer}}

</body>
</html>